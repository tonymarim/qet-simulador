{
  "name": "qet-simulador · simulador de comandos elétricos",
  "short_name": "qet-simulador",
  "description": "Simula comandos elétricos desenhados no QElectroTech (.qet). Funciona sem internet.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f4f2",
  "theme_color": "#1e3a5f",
  "icons": [
    { "src": "icones/icone-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icones/icone-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icones/icone-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/x-qelectrotech-project": [".qet"] } }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
